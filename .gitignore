# ---- nested vendor / engine git metadata (never commit; packs exceed GitHub 100MB limit) ----
**/.git/

# ---- Android / Gradle build output ----
app/build/
app/.cxx/
app/.gradle/
local.properties

# ---- Python venv (bench helper tooling) ----
.venv/
__pycache__/
*.pyc

# ---- third-party caches + unused build dirs.
# IMPORTANT: the engine libraries under
#   third_party/stage/{lw,ort,mnn,ncnn-vulkan}  (lib/ + include/)
# are REQUIRED by the native build (CMake IMPORTED .so/.a + headers), so they
# ARE committed and must NOT be ignored. We only exclude:
#   - download / build caches (_tmp_*, dl/, build-*/)
#   - legacy `stage/ncnn/` prebuilt (CMake does not reference it)
#   - `ncnn-vulkan/include-src/` (42MB of unused vendored layer sources)
#   - the generated pnnx binary + model pack caches
third_party/stage/_tmp_*/
third_party/stage/ncnn/
third_party/stage/ncnn-vulkan/include-src/
third_party/build-ncnn-android/
third_party/build-ncnn-host/
third_party/build-lw-android/
third_party/dl/

# ---- APK artifacts (built product, not source) ----
*.apk

# ---- large binary download caches that must not enter git history ----
*.pack
*.zip
*/_tmp_pnnx/*

# ---- logs / OS noise ----
*.log
.DS_Store
